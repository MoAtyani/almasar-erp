# ==========================================
# ALMASAR ERP - ENVIRONMENT CONFIGURATION
# ==========================================

# 1. PostgreSQL Database Connection
# Connect to PostgreSQL running locally or in Docker
DATABASE_URL=postgres://username:password@localhost:5432/almasar_erp_db

# 2. Supabase Cloud / Self-Hosted (Optional / Hybrid)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# 3. Next.js App Environment
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_random_32_character_string_here

# 4. Company Specific Settings
FACTORY_TIMEZONE=Asia/Riyadh
CURRENCY_CODE=SAR
DEFAULT_LANGUAGE=ar
